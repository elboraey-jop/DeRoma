generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("customer") // "customer", "admin"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Product {
  id             String           @id @default(uuid())
  name           String
  sku            String?          @unique
  description    String?
  price          Decimal
  compareAtPrice Decimal?         // To show discount (e.g. 1200 EGP was 1500 EGP)
  status         String           @default("active") // "active", "draft"
  category       String           // shoes, bags, perfumes, accessories
  subcategory    String?
  brand          String?
  color          String?
  material       String?
  wholesalePrice Decimal?
  additionalCost Decimal?
  supplierId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  badge          String?
  featured       Boolean          @default(false)
  bestSeller     Boolean          @default(false)
  rating         Decimal          @default(0)
  reviewsCount   Int              @default(0)
  lowStockLimit  Int              @default(2)
  images         String[]         // Array of image URLs
  variants       ProductVariant[]
  relatedFrom    ProductRelation[] @relation("ProductRelationsFrom")
  relatedTo      ProductRelation[] @relation("ProductRelationsTo")
  reviews        Review[]
  invoiceItems   PurchaseInvoiceItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orderItems     OrderItem[]
}

model Supplier {
  id           String    @id @default(uuid())
  name         String
  phone        String?
  email        String?
  address      String?
  notes        String?
  products     Product[]
  invoices     PurchaseInvoice[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Customer {
  id           String   @id @default(uuid())
  name         String
  email        String?
  phone        String   @unique
  phone2       String?
  governorate  String
  city         String
  address      String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CatalogOption {
  id         String   @id @default(uuid())
  category   String   // shoes, bags, perfumes, accessories
  type       String   // brand, color, size, material, subcategory, volume
  name       String
  value      String?
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([category, type, name])
  @@index([category, type])
}

model ProductRelation {
  productId        String
  relatedProductId String
  product          Product @relation("ProductRelationsFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product @relation("ProductRelationsTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
}

model ShippingZone {
  id                    String   @id @default(uuid())
  name                  String
  governorates          String[]
  fee                   Decimal
  estimatedDays         String?
  freeShippingThreshold Decimal?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  exceptions            ShippingZoneException[]
}

model ShippingZoneException {
  id             String       @id @default(uuid())
  shippingZoneId String
  city           String
  fee            Decimal
  shippingZone   ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([shippingZoneId, city])
}

model ShippingSettings {
  id                    String   @id @default("default")
  freeShippingEnabled   Boolean  @default(false)
  freeShippingThreshold Decimal?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Promotion {
  id                String    @id @default(uuid())
  code              String?   @unique
  name              String
  type              String    // percentage, fixed, free_shipping
  value             Decimal   @default(0)
  scope             String    @default("order") // order, category, product, color, material
  targetValue      String?
  minimumOrderValue Decimal?
  usageLimit        Int?
  usedCount         Int       @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AnnouncementBar {
  id            String    @id @default(uuid())
  text          String
  backgroundColor String  @default("#942E3A")
  textColor     String    @default("#FFF9EB")
  moving        Boolean   @default(false)
  active        Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ProductVariant {
  id              String      @id @default(uuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size            String      // Shoe size, perfume volume, or ONE_SIZE for bags
  stock           Int         @default(0)
  price           Decimal?
  compareAtPrice  Decimal?
  wholesalePrice  Decimal?
  additionalCost  Decimal?
  orderItems OrderItem[]
  invoiceItems PurchaseInvoiceItem[]
  inventoryLots InventoryLot[]
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique // E.g., DR-0001, then DR-10000 after 9999
  orderSequence  Int         @unique @default(autoincrement())
  customerName   String
  customerPhone  String
  customerPhone2 String?     // Secondary contact
  governorate    String      // Shipping destination (e.g. Cairo)
  city           String
  address        String
  notes          String?
  subtotalPrice  Decimal          @default(0)
  discountAmount Decimal          @default(0)
  manual         Boolean          @default(false)
  paymentMethod  String           @default("cod") // cod, card, wallet, etc.
  totalPrice     Decimal
  shippingCost   Decimal
  status         String      @default("pending") // "pending", "shipped", "delivered", "cancelled"
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]
}

model PurchaseInvoice {
  id            String                 @id @default(uuid())
  invoiceNumber String                 @unique
  supplierId    String
  supplier      Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceDate   DateTime               @default(now())
  dueDate       DateTime?
  reference     String?
  notes         String?
  status        String                 @default("received")
  subtotal      Decimal                @default(0)
  shippingCost  Decimal                @default(0)
  discount      Decimal                @default(0)
  total         Decimal                @default(0)
  amountPaid    Decimal                @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  items         PurchaseInvoiceItem[]

  @@index([supplierId, invoiceDate])
}

model PurchaseInvoiceItem {
  id             String          @id @default(uuid())
  invoiceId      String
  invoice        PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Int
  wholesalePrice Decimal
  retailPrice    Decimal
  lineTotal      Decimal
  notes          String?
  lot            InventoryLot?
}

model InventoryLot {
  id             String              @id @default(uuid())
  variantId      String
  variant        ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  invoiceItemId  String              @unique
  invoiceItem    PurchaseInvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)
  quantity       Int
  remaining      Int
  wholesalePrice Decimal
  retailPrice    Decimal
  receivedAt     DateTime            @default(now())

  @@index([variantId, receivedAt])
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  size        String
  color       String
  quantity    Int
  price       Decimal
  unitCost    Decimal        @default(0)
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName     String
  customerPhone    String?
  rating           Int
  title            String?
  body             String
  status           String   @default("pending") // pending, approved, rejected
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId, status])
}
